# PostPulse Environment Variables Example

# Server & Auth
JWT_SECRET=super-secret-postpulse-jwt-key-2026-change-in-prod
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=postpulse_db

# AI Engine (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Graph API Credentials (Facebook & Instagram)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v19.0

# Set to 'true' for local sandbox testing without approved Meta credentials
USE_MOCK_META=true
